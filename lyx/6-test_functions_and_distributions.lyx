\begin_deeper
\begin_layout Enumerate
יהא 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

.
 אז לכל 
\begin_inset Formula $x\in R$
\end_inset

 נקבל
\begin_inset Formula 
\[
\left(H\ast\phi\right)\left(x\right)=\intop_{R}H\left(x-y\right)\phi\left(y\right)dy=\intop_{-\infty}^{x}\phi\left(y\right)dy
\]

\end_inset

כנדרש.
\end_layout

\begin_layout Enumerate
תהא 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

.
 אז לכל 
\begin_inset Formula $x$
\end_inset

 מתקיים
\begin_inset Formula 
\[
D\left(H\ast\phi\right)\left(x\right)=\left(H\ast D\phi\right)\left(x\right)=\intop_{-\infty}^{x}D\phi\left(y\right)dy=\phi\left(x\right)
\]

\end_inset

כלומר 
\begin_inset Formula $D\left(H\ast\phi\right)=\phi$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $x\in R$
\end_inset

 נקבל
\begin_inset Formula 
\begin{align*}
\left(\delta^{\prime}\ast\left(H\ast\phi\right)\right)\left(x\right) & =\delta^{\prime}\left(\tau_{x}\rho\left(H\ast\phi\right)\right)=-\delta\left(D\tau_{x}\rho\left(H\ast\phi\right)\right)\\
 & =\delta\left(\tau_{x}\rho D\left(H\ast\phi\right)\right)=\delta\left(\tau_{x}\rho\phi\right)=\left(\delta\ast\phi\right)\left(x\right)
\end{align*}

\end_inset

אז לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

 מתקיים 
\begin_inset Formula $\delta\ast\phi=\delta^{\prime}\ast\left(H\ast\phi\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

אבל ההתפלגות היחידה 
\begin_inset Formula $\Lambda$
\end_inset

 שמקיימת לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

 את השוויון 
\begin_inset Formula $\Lambda\ast\phi=\delta^{\prime}\ast\left(H\ast\phi\right)$
\end_inset

 היא 
\begin_inset Formula $\delta^{\prime}\ast H$
\end_inset

, ולכן נקבל 
\begin_inset Formula $\delta=\delta^{\prime}\ast H$
\end_inset

 כנדרש.
\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

 ולכל 
\begin_inset Formula $x\in R$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\left(1\ast\left(\delta^{\prime}\ast\phi\right)\right)\left(x\right) & =\intop_{R}\tau_{x}\rho\left(\delta^{\prime}\ast\phi\right)\left(y\right)dy=\intop_{R}\left(\delta^{\prime}\ast\phi\right)\left(x-y\right)dy\\
 & =\intop_{R}\delta^{\prime}\left(\tau_{x-y}\rho\phi\right)dy=-\intop_{R}\delta\left(D\tau_{x-y}\rho\phi\right)dy\\
 & =\intop_{R}\delta\left(\tau_{x-y}\rho D\phi\right)dy=\intop_{R}\left(\tau_{x-y}\rho D\phi\right)\left(0\right)dy\\
 & =\intop_{R}D\phi\left(x-y\right)dy=0
\end{align*}

\end_inset

כאשר המעבר האחרון הוא כי 
\begin_inset Formula $\phi$
\end_inset

 עם תומך קומפקטי.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

 נקבל
\begin_inset Formula 
\[
\left(1\ast\delta^{\prime}\right)\phi=\left(1\ast\delta^{\prime}\right)\left(\tau_{0}\rho\left(\rho\phi\right)\right)=\left(1\ast\delta^{\prime}\right)\ast\left(\rho\phi\right)=1\ast\left(\delta^{\prime}\ast\left(\rho\phi\right)\right)=0
\]

\end_inset

ולכן 
\begin_inset Formula $1\ast\delta^{\prime}$
\end_inset

 היא התפלגות האפס כנדרש.
\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\left(1\ast\delta\right)\phi & =\left(1\ast\delta\right)\left(\tau_{0}\rho\left(\rho\phi\right)\right)=\left(\left(1\ast\delta\right)\ast\rho\phi\right)\left(0\right)=\left(1\ast\left(\delta\ast\rho\phi\right)\right)\left(0\right)\\
 & =\intop_{R}\tau_{0}\rho\left(\delta\ast\rho\phi\right)\left(y\right)dy=\intop_{R}\left(\delta\ast\rho\phi\right)\left(-y\right)dy\\
 & =\intop_{R}\delta\left(\tau_{-y}\rho\rho\phi\right)dy=\intop_{R}\left(\tau_{-y}\rho\rho\phi\right)\left(0\right)dy=\intop_{R}\phi\left(y\right)dy
\end{align*}

\end_inset

ולכן 
\begin_inset Formula $1\ast\delta=1$
\end_inset

, ולכן נקבל 
\begin_inset Formula $1\ast\left(\delta^{\prime}\ast H\right)=1\ast\delta=1$
\end_inset

.
\begin_inset Newline newline
\end_inset

מצד שני לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(R\right)$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\left(0\ast H\right)\phi & =\left(0\ast H\right)\left(\tau_{0}\rho\rho\phi\right)=\left(\left(0\ast H\right)\ast\rho\phi\right)\left(0\right)\\
 & =\intop_{R}0\cdot\left(\tau_{0}\rho\left(H\ast\rho\phi\right)\right)\left(y\right)dy=0
\end{align*}

\end_inset

ולכן 
\begin_inset Formula $0\ast H=0$
\end_inset

, ולכן 
\begin_inset Formula $\left(1\ast\delta^{\prime}\right)\ast H=0\ast H=0$
\end_inset

.
