\[
\left(\intop_{-A}^{-\delta}+\intop_{\delta}^{A}\right)\frac{\phi^{\prime}\left(x\right)}{x}dx\xrightarrow[\delta\rightarrow0]{}\Lambda^{\prime}\left(\phi^{\prime}\right)
\]

\end_inset

ולכן נקבל
\begin_inset Formula 
\[
\left(\intop_{-A}^{-\delta}+\intop_{\delta}^{A}\right)\frac{\phi\left(x\right)-\phi\left(0\right)}{x^{2}}dx\xrightarrow[\delta\rightarrow0]{}\Lambda^{\prime}\left(\phi^{\prime}\right)=-\Lambda^{\prime\prime}\phi
\]

\end_inset

כלומר אכן 
\begin_inset Formula $\Lambda^{\prime\prime}\phi=-PV\intop_{-\infty}^{\infty}x^{-2}\left(\phi\left(x\right)-\phi\left(0\right)\right)dx$
\end_inset

 כנדרש.
\end_layout

