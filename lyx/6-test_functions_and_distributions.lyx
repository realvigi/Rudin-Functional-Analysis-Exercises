ולכן
\begin_inset Formula 
\begin{align*}
\intop_{S\cap\left(A+\overline{B_{2j^{-1}}\left(0\right)}\right)}\left|\Lambda\left(\tau_{x}\rho h_{j}\right)\right|\left|\phi\left(x\right)\right|dx & \leq Cj^{n+N}\left\Vert h\right\Vert _{N}\intop_{S\cap\left(A+\overline{B_{2j^{-1}}\left(0\right)}\right)}\left|\phi\left(x\right)\right|dx\\
 & \leq Cj^{n+N}\left\Vert h\right\Vert _{N}m\left(S\right)\sup\left\{ \left|\phi\left(x\right)\right|:x\in A+\overline{B_{2j^{-1}}\left(0\right)}\right\} 
\end{align*}

\end_inset

וזה נכון לכל 
\begin_inset Formula $j$
\end_inset

.
\begin_inset Newline newline
\end_inset

