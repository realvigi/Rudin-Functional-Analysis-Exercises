\begin_inset Formula 
\[
\left|\Lambda\left(\tau_{x}\rho h_{j}\right)\right|\leq C\left\Vert \tau_{x}\rho h_{j}\right\Vert _{N}=C\left\Vert h_{j}\right\Vert _{N}\leq Cj^{n+N}\left\Vert h\right\Vert _{N}
\]

