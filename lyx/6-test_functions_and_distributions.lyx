\begin_inset Formula $j$
\end_inset

 ו-
\begin_inset Formula $\gamma$
\end_inset

 עם 
\begin_inset Formula $\left|\gamma\right|=n$
\end_inset

 עבורו 
\begin_inset Formula $\alpha=\gamma+e$
\end_inset

 כאשר 
\begin_inset Formula $e_{i}=\delta_{ij}$
\end_inset

 ואז
\begin_inset Formula 
\begin{align*}
D^{\alpha}\left(fg\right) & =D^{\gamma}D_{j}\left(fg\right)=D^{\gamma}\left(\left(D_{j}f\right)g+f\left(D_{j}g\right)\right)=D^{\gamma}\left(\left(D_{j}f\right)g\right)+D^{\gamma}\left(f\left(D_{j}g\right)\right)\\
 & =\sum_{\beta\leq\gamma}c_{\gamma\beta}\left(D^{\gamma-\beta}D_{j}f\right)\left(D^{\beta}g\right)+\sum_{\beta\leq\gamma}c_{\gamma\beta}\left(D^{\gamma-\beta}f\right)\left(D^{\beta}D_{j}g\right)\\
 & =\sum_{\beta\leq\gamma}c_{\gamma\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)+\sum_{\beta\leq\gamma}c_{\gamma\beta}\left(D^{\alpha-\left(\beta+e\right)}f\right)\left(D^{\beta+e}g\right)\\
 & =\sum_{\beta\leq\gamma}c_{\gamma\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)+\sum_{e\leq\beta\leq\alpha}c_{\gamma,\left(\beta-e\right)}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)\\
 & =\sum_{\beta\leq\gamma,\beta_{j}=0}c_{\gamma\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)+\sum_{e\leq\beta\leq\gamma}\left(c_{\gamma\beta}+c_{\gamma,\left(\beta-e\right)}\right)\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)+\sum_{\beta\leq\alpha,\beta_{j}=\alpha_{j}}c_{\gamma,\left(\beta-e\right)}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)
\end{align*}

\end_inset

עכשיו נבחין שאם 
\begin_inset Formula $\beta\leq\gamma,\beta_{j}=0$
\end_inset

, אז מתקיים
\begin_inset Formula 
\[
c_{\gamma\beta}=\prod_{i=1}^{n}\frac{\gamma_{i}!}{\beta_{i}!\left(\gamma_{i}-\beta_{i}\right)!}=\prod_{i\neq j}\frac{\gamma_{i}!}{\beta_{i}!\left(\gamma_{i}-\beta_{i}\right)!}=\prod_{i\neq j}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}=\prod_{i=1}^{n}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}=c_{\alpha\beta}
\]

\end_inset

ואם 
\begin_inset Formula $e\leq\beta\leq\gamma$
\end_inset

 אז
\begin_inset Formula 
\begin{align*}
c_{\gamma\beta}+c_{\gamma,\left(\beta-e\right)} & =\prod_{i=1}^{n}\frac{\gamma_{i}!}{\beta_{i}!\left(\gamma_{i}-\beta_{i}\right)!}+\prod_{i=1}^{n}\frac{\gamma_{i}!}{\left(\beta_{i}-e_{i}\right)!\left(\gamma_{i}-\left(\beta_{i}-e_{i}\right)\right)!}=\left(\frac{\gamma_{j}!}{\beta_{j}!\left(\gamma_{j}-\beta_{j}\right)!}+\frac{\gamma_{j}!}{\left(\beta_{j}-1\right)!\left(\gamma_{j}-\left(\beta_{j}-1\right)\right)!}\right)\prod_{i\neq j}\frac{\gamma_{i}!}{\beta_{i}!\left(\gamma_{i}-\beta_{i}\right)!}\\
 & =\left(\frac{\alpha_{j}!}{\beta_{j}!\left(\alpha_{j}-\beta_{j}\right)!}\right)\prod_{i\neq j}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}=\prod_{i=1}^{n}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}=c_{\alpha\beta}
\end{align*}

\end_inset

ואם 
\begin_inset Formula $\beta\leq\alpha,\beta_{j}=\alpha_{j}$
\end_inset

 אז
\begin_inset Formula 
\begin{align*}
c_{\gamma,\left(\beta-e\right)} & =\prod_{i=1}^{n}\frac{\gamma_{i}!}{\left(\beta_{i}-e_{i}\right)!\left(\gamma_{i}-\left(\beta_{i}-e_{i}\right)\right)!}=\frac{\gamma_{j}!}{\left(\beta_{j}-1\right)!\left(\gamma_{j}-\left(\beta_{j}-1\right)\right)!}\prod_{i\neq j}\frac{\gamma_{i}!}{\beta_{i}!\left(\gamma_{i}-\beta_{i}\right)!}=\frac{\alpha_{j}}{\beta_{j}}\cdot\frac{\gamma_{j}!}{\left(\beta_{j}-1\right)!\left(\alpha_{j}-\beta_{j}\right)!}\prod_{i\neq j}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}\\
 & =\frac{\alpha_{j}!}{\beta_{j}!\left(\alpha_{j}-\beta_{j}\right)!}\prod_{i\neq j}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}=\prod_{i=1}^{n}\frac{\alpha_{i}!}{\beta_{i}!\left(\alpha_{i}-\beta_{i}\right)!}=c_{\alpha\beta}
\end{align*}

\end_inset

ולכן נקבל
\begin_inset Formula 
\begin{align*}
D^{\alpha}\left(fg\right) & =\sum_{\beta\leq\gamma,\beta_{j}=0}c_{\alpha\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)+\sum_{e\leq\beta\leq\gamma}c_{\alpha\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)+\sum_{\beta\leq\alpha,\beta_{j}=\alpha_{j}}c_{\alpha\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)=\sum_{\beta\leq\alpha}c_{\alpha\beta}\left(D^{\alpha-\beta}f\right)\left(D^{\beta}g\right)
\end{align*}

\end_inset

כנדרש.
