\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $\log\left|x\right|$
\end_inset

 היא קדומה של 
\begin_inset Formula $x^{-1}$
\end_inset

 בתחום 
\begin_inset Formula $R\setminus\left\{ 0\right\} $
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $\delta>0$
\end_inset

 נקבל
\begin_inset Formula 
\begin{align*}
\intop_{-\infty}^{-\delta}\phi\left(x\right)\frac{dx}{x} & =\intop_{A}^{-\delta}\phi\left(x\right)\frac{dx}{x}\\
 & =\phi\left(-\delta\right)\log\left(\delta\right)-\intop_{A}^{-\delta}\phi^{\prime}\left(x\right)\log\left|x\right|dx\\
\intop_{\delta}^{\infty}\phi\left(x\right)\frac{dx}{x} & =\intop_{\delta}^{A}\phi\left(x\right)\frac{dx}{x}\\
 & =-\phi\left(\delta\right)\log\left(\delta\right)-\intop_{\delta}^{A}\phi^{\prime}\left(x\right)\log\left|x\right|dx
\end{align*}

\end_inset

ולכן לכל 
\begin_inset Formula $\delta>0$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\left(\intop_{-\infty}^{-\delta}+\intop_{\delta}^{\infty}\right)\phi\left(x\right)\frac{dx}{x} & =\left(\phi\left(-\delta\right)-\phi\left(\delta\right)\right)\log\left(\delta\right)-\left(\intop_{A}^{-\delta}\phi^{\prime}\left(x\right)\log\left|x\right|dx+\intop_{\delta}^{A}\phi^{\prime}\left(x\right)\log\left|x\right|dx\right)
\end{align*}

\end_inset

מתכונות רגילות של אינטגרל לבג ברור שמתקיים
\begin_inset Formula 
\[
\intop_{A}^{-\delta}\phi^{\prime}\left(x\right)\log\left|x\right|dx+\intop_{\delta}^{A}\phi^{\prime}\left(x\right)\log\left|x\right|dx\xrightarrow[\delta\rightarrow0]{}\Lambda\left(\phi^{\prime}\right)
\]

\end_inset

וכמו כן מכלל לופיטל נקבל
\begin_inset Formula 
\begin{align*}
\lim_{\delta\rightarrow0}\left(\phi\left(-\delta\right)-\phi\left(\delta\right)\right)\log\left(\delta\right) & =\lim_{\delta\rightarrow0}\frac{\phi\left(-\delta\right)-\phi\left(\delta\right)}{\left(\log\delta\right)^{-1}}=\lim_{\delta\rightarrow0}\frac{-\phi^{\prime}\left(-\delta\right)-\phi^{\prime}\left(\delta\right)}{-\left(\log\delta\right)^{-2}\delta^{-1}}\\
 & =\lim_{\delta\rightarrow0}\delta\left(\log\delta\right)^{2}\left(\phi^{\prime}\left(-\delta\right)+\phi^{\prime}\left(\delta\right)\right)
\end{align*}

\end_inset

מכלל לופיטל שוב מתקיים
\begin_inset Formula 
\begin{align*}
\lim_{\delta\rightarrow0}\delta\left(\log\delta\right)^{2} & =\lim_{\delta\rightarrow0}\frac{\left(\log\delta\right)^{2}}{\delta^{-1}}=\lim_{\delta\rightarrow0}\frac{2\left(\log\delta\right)\delta^{-1}}{-\delta^{-2}}=-2\lim_{\delta\rightarrow0}\frac{\left(\log\delta\right)}{\delta^{-1}}\\
 & =-2\lim_{\delta\rightarrow0}\frac{\delta^{-1}}{-\delta^{-2}}=2\lim_{\delta\rightarrow0}\delta=0
\end{align*}

\end_inset

וכמו כן 
\begin_inset Formula $\phi^{\prime}\left(-\delta\right)+\phi^{\prime}\left(\delta\right)\xrightarrow[\delta\rightarrow0]{}2\phi^{\prime}\left(0\right)$
\end_inset

 ולכן קיבלנו
\begin_inset Formula 
\[
\lim_{\delta\rightarrow0}\left(\phi\left(-\delta\right)-\phi\left(\delta\right)\right)\log\left(\delta\right)=\lim_{\delta\rightarrow0}\delta\left(\log\delta\right)^{2}\left(\phi^{\prime}\left(-\delta\right)+\phi^{\prime}\left(\delta\right)\right)=0
\]

\end_inset

ולכן בסך הכול
\begin_inset Formula 
\[
\left(\intop_{-\infty}^{-\delta}+\intop_{\delta}^{\infty}\right)\phi\left(x\right)\frac{dx}{x}\xrightarrow[\delta\rightarrow0]{}0-\Lambda\left(\phi^{\prime}\right)=\Lambda^{\prime}\phi
\]

\end_inset

ולכן 
\begin_inset Formula $\Lambda^{\prime}\phi=PV\intop_{-\infty}^{\infty}\phi\left(x\right)\frac{dx}{x}$
\end_inset

 כנדרש.
\end_layout

\begin_layout Enumerate
יהיו 
\begin_inset Formula $\phi$
\end_inset

 ו-
\begin_inset Formula $A>0$
\end_inset

 כמו קודם.
\begin_inset Newline newline
\end_inset

מאינטגרציה בחלקים, לכל 
\begin_inset Formula $\delta>0$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\intop_{-A}^{-\delta}\frac{\phi\left(x\right)-\phi\left(0\right)}{x^{2}}dx & =\frac{\phi\left(-\delta\right)-\phi\left(0\right)}{\delta}+\frac{\phi\left(0\right)}{A}+\intop_{-A}^{-\delta}\frac{\phi^{\prime}\left(x\right)}{x}dx\\
\intop_{\delta}^{A}\frac{\phi\left(x\right)-\phi\left(0\right)}{x^{2}}dx & =\frac{\phi\left(0\right)}{A}+\frac{\phi\left(\delta\right)-\phi\left(0\right)}{\delta}+\intop_{\delta}^{A}\frac{\phi^{\prime}\left(x\right)}{x}dx
\end{align*}

\end_inset

כמו כן מתקיים
\begin_inset Formula 
\begin{align*}
\intop_{-\infty}^{-A}\frac{\phi\left(x\right)-\phi\left(0\right)}{x^{2}}dx & =-\phi\left(0\right)\intop_{-\infty}^{-A}\frac{1}{x^{2}}dx=-\frac{\phi\left(0\right)}{A}\\
\intop_{A}^{\infty}\frac{\phi\left(x\right)-\phi\left(0\right)}{x^{2}}dx & =-\phi\left(0\right)\intop_{A}^{\infty}\frac{1}{x^{2}}dx=-\frac{\phi\left(0\right)}{A}
\end{align*}

\end_inset

ולכן לכל 
\begin_inset Formula $\delta>0$
\end_inset

 נקבל
\begin_inset Formula 
\[
\left(\intop_{-A}^{-\delta}+\intop_{\delta}^{A}\right)\frac{\phi\left(x\right)-\phi\left(0\right)}{x^{2}}dx=\frac{\phi\left(-\delta\right)-\phi\left(0\right)}{\delta}+\frac{\phi\left(\delta\right)-\phi\left(0\right)}{\delta}+\left(\intop_{-A}^{-\delta}+\intop_{\delta}^{A}\right)\frac{\phi^{\prime}\left(x\right)}{x}dx
\]

\end_inset

מתקיים 
\begin_inset Formula 
\[
\frac{\phi\left(\delta\right)-\phi\left(0\right)}{\delta}\xrightarrow[\delta\rightarrow0]{}\phi^{\prime}\left(0\right)
\]

\end_inset

וכמו כן אם נסמן 
\begin_inset Formula $\psi\left(x\right)=\phi\left(-x\right)$
\end_inset

 אז מכלל השרשרת נקבל
