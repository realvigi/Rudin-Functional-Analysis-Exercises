ולכן
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\begin{align*}
\left|D^{\alpha}\phi\left(x\right)\right| & \leq\sum_{i=1}^{n}\left|x_{i}-a_{i}\right|\intop_{0}^{1}\left|D^{\alpha+e_{i}}\phi\left(a+t\left(x-a\right)\right)\right|dt\\
 & \leq\left|x-a\right|\sum_{i=1}^{n}\intop_{0}^{1}\left|D^{\alpha+e_{i}}\phi\left(a+t\left(x-a\right)\right)\right|dt\\
 & \leq\left|x-a\right|\sum_{i=1}^{n}\intop_{0}^{1}C_{k,\alpha+e_{i}}t^{k}\left|x-a\right|^{k}dt\\
 & =\left(\frac{1}{k+1}\sum_{i=1}^{n}C_{k,\alpha+e_{i}}\right)\left|x-a\right|^{k+1}\\
 & <C_{k+1,\alpha}\left|x-a\right|^{k+1}
\end{align*}

\end_inset

