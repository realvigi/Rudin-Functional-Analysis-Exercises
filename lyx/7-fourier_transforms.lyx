\end_inset


\end_layout

\begin_deeper
\begin_layout Enumerate
צריך להראות שלכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(\Omega\right)$
\end_inset

 מתקיים 
\begin_inset Formula $\intop_{R^{n}}\widehat{\phi}d\mu=\intop_{R^{n}}\widehat{\mu}\phi dm_{n}$
\end_inset

, כאשר 
\begin_inset Formula $\widehat{\mu}$
\end_inset

 מוגדרת כפונקציה כמו בתרגיל.
\begin_inset Newline newline
\end_inset

מתקיים 
\begin_inset Formula 
\[
\intop_{R^{n}}\intop_{R^{n}}\left|\phi\left(x\right)e^{-it\cdot x}\right|dm_{n}\left(x\right)d\mu\left(t\right)=\left\Vert \phi\right\Vert _{1}\mu\left(R^{n}\right)<\infty
\]

\end_inset

ולכן ממשפט פוביני מתקיים
\begin_inset Formula 
\[
\intop_{R^{n}}\intop_{R^{n}}\left|\phi\left(x\right)e^{-it\cdot x}\right|dm_{n}\left(x\right)d\mu\left(t\right)=\intop_{R^{n}}\intop_{R^{n}}\phi\left(x\right)e^{-it\cdot x}d\mu\left(t\right)dm_{n}\left(x\right)
\]

\end_inset

ולכן נקבל
\begin_inset Formula 
\begin{align*}
\intop_{R^{n}}\widehat{\phi}d\mu & =\intop_{R^{n}}\intop_{R^{n}}\phi\left(x\right)e^{-it\cdot x}dm_{n}\left(x\right)d\mu\left(t\right)\\
 & =\intop_{R^{n}}\left(\intop_{R^{n}}e^{-it\cdot x}d\mu\left(t\right)\right)\phi\left(x\right)dm_{n}\left(x\right)\\
 & =\intop_{R^{n}}\widehat{\mu}\left(x\right)\phi\left(x\right)dm_{n}\left(x\right)
\end{align*}

\end_inset

כנדרש.
\end_layout

\begin_layout Enumerate
נראה ש-
\begin_inset Formula $\widehat{\mu}$
\end_inset

 חסומה.
 אכן, לכל 
\begin_inset Formula $x$
\end_inset

 מתקיים
\begin_inset Formula 
\[
\left|\widehat{\mu}\left(x\right)\right|\leq\intop_{R^{n}}\left|e^{-ix\cdot t}\right|d\mu\left(t\right)=\intop_{R^{n}}d\mu\left(t\right)=\mu\left(R^{n}\right)<\infty
\]

\end_inset

כנדרש.
\end_layout

\begin_layout Enumerate
נראה ש-
\begin_inset Formula $\widehat{\mu}$
\end_inset

 רציפה במ
\begin_inset Quotes erd
\end_inset

ש.
\begin_inset Newline newline
\end_inset

מתקיים 
\begin_inset Formula $e^{ix\cdot t}-1\xrightarrow[x\rightarrow0]{}0$
\end_inset

, וכמו כן 
\begin_inset Formula $\left|e^{ix\cdot t}-1\right|\leq2$
\end_inset

 לכל 
\begin_inset Formula $x,t\in R^{n}$
\end_inset

, ו-
\begin_inset Formula $2\in L^{1}\left(\mu\right)$
\end_inset

 שכן 
\begin_inset Formula $\mu\left(R^{n}\right)<\infty$
\end_inset

.
 אז ממשפט ההתכנסות הנשלטת נקבל 
\begin_inset Formula 
\[
\intop_{R^{n}}\left|e^{ix\cdot t}-1\right|d\mu\left(t\right)\xrightarrow[x\rightarrow0]{}0
\]

\end_inset

עכשיו יהא 
\begin_inset Formula $\varepsilon>0$
\end_inset

.
 ממה שראינו יש 
\begin_inset Formula $\delta>0$
\end_inset

 עבורו אם 
\begin_inset Formula $\left|x\right|<\delta$
\end_inset

, אז 
\begin_inset Formula $\intop_{R^{n}}\left|e^{ix\cdot t}-1\right|d\mu\left(t\right)<\varepsilon$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $a,b\in R^{n}$
\end_inset

, אם 
\begin_inset Formula $\left|a-b\right|<\delta$
\end_inset

, נקבל
\begin_inset Formula 
\[
\left|\widehat{\mu}\left(a\right)-\widehat{\mu}\left(b\right)\right|\leq\intop_{R^{n}}\left|e^{-ia\cdot t}-e^{-ib\cdot t}\right|d\mu\left(t\right)=\intop_{R^{n}}\left|e^{i\left(b-a\right)\cdot t}-1\right|d\mu\left(t\right)<\varepsilon
\]

\end_inset

וזה מראה ש-
\begin_inset Formula $\widehat{\mu}$
\end_inset

 רציפה במ
\begin_inset Quotes erd
\end_inset

ש כנדרש.
\end_layout

\end_deeper
\begin_layout Enumerate
לכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

 נגדיר 
\begin_inset Formula $u\left(\phi\right)=\left(\Lambda\rho\phi\right)\left(0\right)$
\end_inset

.
 
\begin_inset Formula $\rho$
\end_inset

 הוא אופרטור לינארי רציף על 
\begin_inset Formula $\mathcal{S}_{n}$
\end_inset

 ושערוך ב-
\begin_inset Formula $0$
\end_inset

 היא פונקציונל לינארי רציף על 
\begin_inset Formula $C\left(R^{n}\right)$
\end_inset

, ולכן 
\begin_inset Formula $u$
\end_inset

 פונקציונל לינארי רציף על 
\begin_inset Formula $\mathcal{S}_{n}$
\end_inset

, כלומר 
\begin_inset Formula $u\in\mathcal{S}_{n}^{\prime}$
\end_inset

.
\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

 ולכל 
\begin_inset Formula $x\in R^{n}$
\end_inset

 מתקיים
\begin_inset Formula 
\[
\left(u\ast\phi\right)\left(x\right)=u\left(\tau_{x}\rho\phi\right)=\left(\Lambda\rho\tau_{x}\rho\phi\right)\left(0\right)=\left(\Lambda\tau_{-x}\rho\rho\phi\right)\left(0\right)=\left(\tau_{-x}\Lambda\phi\right)\left(0\right)=\left(\Lambda\phi\right)\left(x\right)
\]

\end_inset

ולכן 
\begin_inset Formula $\Lambda\phi=u\ast\phi$
\end_inset

 לכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

 כנדרש.
\end_layout

\begin_layout Enumerate
תהא 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

.
 נסמן 
\begin_inset Formula $C=\left(\sum_{i=1}^{n}\left\Vert D^{e_{i}}\phi\right\Vert _{\infty}^{2}\right)^{\nicefrac{1}{2}}$
\end_inset

.
\begin_inset Newline newline
\end_inset

נקבע 
\begin_inset Formula $x,y\in R^{n}$
\end_inset

.
 נסמן 
\begin_inset Formula $g\left(t\right)=\phi\left(x+t\left(y-x\right)\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז 
\begin_inset Formula $g$
\end_inset

 גזירה ברציפה ולכל 
\begin_inset Formula $t$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\left|g^{\prime}\left(t\right)\right| & =\left|\left(y-x\right)\cdot\nabla\phi\left(t\right)\right|\leq\left|y-x\right|\left|\nabla\phi\left(t\right)\right|=\left|y-x\right|\left(\sum_{i=1}^{n}\left(D^{e_{i}}\phi\left(t\right)\right)^{2}\right)^{\nicefrac{1}{2}}\\
 & \leq\left|y-x\right|\left(\sum_{i=1}^{n}\left\Vert D^{e_{i}}\phi\right\Vert _{\infty}^{2}\right)^{\nicefrac{1}{2}}=C\left|y-x\right|
\end{align*}

\end_inset

ולכן ממשפט ערך הביניים, יש 
\begin_inset Formula $c\in\left[0,1\right]$
\end_inset

 עבורו
\begin_inset Formula 
\[
\left|\phi\left(y\right)-\phi\left(x\right)\right|=\left|g\left(1\right)-g\left(0\right)\right|=\left|g^{\prime}\left(c\right)\right|\leq C\left|y-x\right|
\]

\end_inset

ומשרירותיות 
\begin_inset Formula $x,y$
\end_inset

, קיבלנו שלכל 
\begin_inset Formula $x,y\in R^{n}$
\end_inset

 מתקיים 
\begin_inset Formula $\left|\phi\left(y\right)-\phi\left(x\right)\right|\leq C\left|y-x\right|$
\end_inset

.
\begin_inset Newline newline
\end_inset

זה מראה שלכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

 יש 
\begin_inset Formula $C_{\phi}>0$
\end_inset

 עבורו 
\begin_inset Formula $\left\Vert \tau_{y}\phi-\phi\right\Vert _{\infty}\leq C_{\phi}\left|y\right|$
\end_inset

 לכל 
\begin_inset Formula $y\in R^{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

תהא 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

, ויהיו 
\begin_inset Formula $\alpha,\beta$
\end_inset

 מולטי-אינדקסים.
 לכל 
\begin_inset Formula $\gamma$
\end_inset

 נסמן 
\begin_inset Formula $Q_{\gamma}\left(x\right)=x^{\gamma}$
\end_inset

.
\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $\gamma\leq\beta$
\end_inset

 ולכל 
\begin_inset Formula $j$
\end_inset


\begin_inset Formula 
\[
f_{j,\gamma}\left(x\right)=\intop_{R^{n}}y^{\beta-\gamma}h_{j}\left(y\right)\left(x-y\right)^{\gamma}D^{\alpha}\phi\left(x-y\right)dm_{n}\left(y\right)
\]

\end_inset


\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $j$
\end_inset

 ולכל 
\begin_inset Formula $x$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
x^{\beta}D^{\alpha}\left(h_{j}\ast\phi\right)\left(x\right)-x^{\beta}D^{\alpha}\phi\left(x\right) & =\intop_{R^{n}}\left(y+x-y\right)^{\beta}h_{j}\left(y\right)D^{\alpha}\phi\left(x-y\right)dm_{n}\left(y\right)-x^{\beta}D^{\alpha}\phi\left(x\right)\\
 & =\sum_{\gamma\leq\beta}c_{\beta\gamma}\intop_{R^{n}}y^{\beta-\gamma}h_{j}\left(y\right)\left(x-y\right)^{\gamma}D^{\alpha}\phi\left(x-y\right)dm_{n}\left(y\right)-x^{\beta}D^{\alpha}\phi\left(x\right)\\
 & =\left(\sum_{\gamma\leq\beta}c_{\beta\gamma}f_{j,\gamma}\left(x\right)\right)-x^{\beta}D^{\alpha}\phi\left(x\right)
\end{align*}

\end_inset

ומכך ש-
\begin_inset Formula $c_{\beta\beta}=1$
\end_inset

 נקבל לכל 
\begin_inset Formula $j$
\end_inset

 קיבלנו את השוויון
\begin_inset Formula 
\[
Q_{\beta}D^{\alpha}\left(h_{j}\ast\phi\right)-Q_{\beta}D^{\alpha}\phi=\left(f_{j,\beta}-x^{\beta}D^{\alpha}\phi\right)+\left(\sum_{\gamma<\beta}c_{\beta\gamma}f_{j,\gamma}\right)
\]

\end_inset

מכך ש-
\begin_inset Formula $Q_{\beta}D^{\alpha}\phi\in\mathcal{S}_{n}$
\end_inset

 נקבל
\begin_inset Formula 
\begin{align*}
\left\Vert f_{j,\beta}-x^{\beta}D^{\alpha}\phi\right\Vert _{\infty} & =\sup_{x\in R^{n}}\left|\intop_{R^{n}}h_{j}\left(y\right)\left(\left(x-y\right)^{\beta}D^{\alpha}\phi\left(x-y\right)-x^{\beta}D^{\alpha}\phi\left(x\right)\right)dm_{n}\left(y\right)\right|\\
 & \leq\sup_{x\in R^{n}}\intop_{R^{n}}h_{j}\left(y\right)\left|\left(\tau_{y}\left(Q_{\beta}D^{\alpha}\phi\right)\right)\left(x\right)-\left(Q_{\beta}D^{\alpha}\phi\right)\left(x\right)\right|dm_{n}\left(y\right)\\
 & \leq\sup_{x\in R^{n}}\intop_{B\left(0,j^{-1}\right)}h_{j}\left(y\right)\left\Vert \tau_{y}\left(Q_{\beta}D^{\alpha}\phi\right)-Q_{\beta}D^{\alpha}\phi\right\Vert _{\infty}dm_{n}\left(y\right)\\
 & \leq\sup_{x\in R^{n}}\intop_{B\left(0,j^{-1}\right)}h_{j}\left(y\right)C_{Q_{\beta}D^{\alpha}\phi}\left|y\right|dm_{n}\left(y\right)\\
 & \leq C_{Q_{\beta}D^{\alpha}\phi}j^{-1}\sup_{x\in R^{n}}\intop_{B\left(0,j^{-1}\right)}h_{j}\left(y\right)dm_{n}\left(y\right)=C_{Q_{\beta}D^{\alpha}\phi}j^{-1}\xrightarrow[j\rightarrow\infty]{}0
\end{align*}

\end_inset

ולכן 
\begin_inset Formula $f_{j,\beta}-x^{\beta}D^{\alpha}\phi\rightarrow0$
\end_inset

 במ
\begin_inset Quotes erd
\end_inset

ש על 
\begin_inset Formula $R^{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

כמו כן לכל 
\begin_inset Formula $\gamma<\beta$
\end_inset

 מתקיים 
\begin_inset Formula $\left|\beta-\gamma\right|\geq1$
\end_inset

 ולכן
\begin_inset Formula 
\begin{align*}
\left\Vert f_{j,\gamma}\right\Vert _{\infty} & \leq\sup_{x\in R^{n}}\intop_{R^{n}}\left|y^{\beta-\gamma}\right|h_{j}\left(y\right)\left|\left(x-y\right)^{\gamma}D^{\alpha}\phi\left(x-y\right)\right|dm_{n}\left(y\right)\\
 & \leq\left\Vert Q_{\gamma}D^{\alpha}\phi\right\Vert _{\infty}\intop_{B\left(0,j^{-1}\right)}\left|y^{\beta-\gamma}\right|h_{j}\left(y\right)dm_{n}\left(y\right)\\
 & \leq\left\Vert Q_{\gamma}D^{\alpha}\phi\right\Vert _{\infty}\intop_{B\left(0,j^{-1}\right)}\left|y\right|^{\left|\beta-\gamma\right|}h_{j}\left(y\right)dm_{n}\left(y\right)\\
 & \leq\left\Vert Q_{\gamma}D^{\alpha}\phi\right\Vert _{\infty}j^{-\left|\beta-\gamma\right|}\intop_{B\left(0,j^{-1}\right)}h_{j}\left(y\right)dm_{n}\left(y\right)\\
 & =\left\Vert Q_{\gamma}D^{\alpha}\phi\right\Vert _{\infty}j^{-\left|\beta-\gamma\right|}\xrightarrow[j\rightarrow\infty]{}0
\end{align*}

\end_inset

ולכן 
\begin_inset Formula $f_{j,\gamma}\rightarrow0$
\end_inset

 במ
\begin_inset Quotes erd
\end_inset

ש על כל 
\begin_inset Formula $R^{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

זה מראה ש-
\begin_inset Formula $Q_{\beta}D^{\alpha}\left(h_{j}\ast\phi\right)-Q_{\beta}D^{\alpha}\phi\rightarrow0$
\end_inset

 במ
\begin_inset Quotes erd
\end_inset

ש על 
\begin_inset Formula $R^{n}$
\end_inset

, כלומר 
\begin_inset Formula $Q_{\beta}D^{\alpha}\left(h_{j}\ast\phi\right)\rightarrow Q_{\beta}D^{\alpha}\phi$
\end_inset

 במ
\begin_inset Quotes erd
\end_inset

ש על 
\begin_inset Formula $R^{n}$
\end_inset

, לכל 
\begin_inset Formula $\alpha,\beta$
\end_inset

 מולטיאינדקסים ולכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

זה מראה שלכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

, 
\begin_inset Formula $\alpha$
\end_inset

 מולטי-אינדקס ו-
\begin_inset Formula $P$
\end_inset

 פולינום מתקיים 
\begin_inset Formula $PD^{\alpha}\left(h_{j}\ast\phi\right)\rightarrow PD^{\alpha}\phi$
\end_inset

 במ
\begin_inset Quotes erd
\end_inset

ש על 
\begin_inset Formula $R^{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $\left\{ h_{j}\right\} $
\end_inset

 יחידה מקורבת, ולכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

 מתקיים 
\begin_inset Formula $h_{j}\ast\phi\rightarrow\phi$
\end_inset

 בטופולוגיה של 
\begin_inset Formula $\mathcal{S}_{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

אבל אם 
\begin_inset Formula $\left\{ h_{j}\right\} $
\end_inset

 היא יחידה מקורבת אז גם 
\begin_inset Formula $\left\{ \rho h_{j}\right\} $
\end_inset

 היא יחידה מקורבת ולכן לכל 
\begin_inset Formula $u\in\mathcal{S}_{n}^{\prime}$
\end_inset

, ולכל 
\begin_inset Formula $\phi\in\mathcal{S}_{n}$
\end_inset

, נקבל
\begin_inset Formula 
\begin{align*}
\left(u\ast h_{j}\right)\left(\phi\right) & =\left(\left(u\ast h_{j}\right)\ast\rho\phi\right)\left(0\right)=\left(u\ast\left(h_{j}\ast\rho\phi\right)\right)\left(0\right)=u\left(\rho\left(h_{j}\ast\rho\phi\right)\right)\\
 & =u\left(\left(\rho h_{j}\right)\ast\phi\right)\xrightarrow[j\rightarrow\infty]{}u\left(\phi\right)
\end{align*}

\end_inset

כלומר 
\begin_inset Formula $u\ast h_{j}\rightarrow u$
\end_inset

 בטופולגיה החלשה
\begin_inset Formula $^{*}$
\end_inset

 של 
\begin_inset Formula $\mathcal{S}_{n}^{\prime}$
\end_inset

 כנדרש.
