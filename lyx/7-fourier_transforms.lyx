 & \leq\left(\intop_{R\setminus\left(-1,1\right)}\frac{1}{\left|t\right|^{2}}dm\right)^{\nicefrac{1}{2}}\left\Vert \widehat{Du}\right\Vert _{2}<\infty
\end{align*}

