\begin_inset Formula 
\[
\left\Vert D^{\alpha}\phi\right\Vert _{\infty}\leq\sum_{k\in\kaliInteger^{n}}\left|k^{\alpha}\widehat{\phi}\left(k\right)\right|\leq\sum_{k\in\kaliInteger^{n}}\left|k\right|^{\left|\alpha\right|}\left|\widehat{\phi}\left(k\right)\right|
\]

\end_inset

עכשיו נקבע 
\begin_inset Formula $N$
\end_inset

 כלשהו.
 ניקח 
\begin_inset Formula $m$
\end_inset

 גדול מספיק עבורו 
\begin_inset Formula $\sum_{k\in\kaliInteger^{n}}\left|k\right|^{2\left(N-m\right)}<\infty$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $\alpha$
\end_inset

 עם 
\begin_inset Formula $\left|\alpha\right|\leq N$
\end_inset

 נקבל מא
\begin_inset Quotes erd
\end_inset

ש הולדר
\begin_inset Formula 
\begin{align*}
\left\Vert D^{\alpha}\phi\right\Vert _{\infty} & \leq\sum_{k\in\kaliInteger^{n}}\left|k\right|^{\left|\alpha\right|}\left|\widehat{\phi}\left(k\right)\right|=\sum_{k\in\kaliInteger^{n}}\left|k\right|^{\left|\alpha\right|-m}\left|k\right|^{m}\left|\widehat{\phi}\left(k\right)\right|\\
 & \leq\left(\sum_{k\in\kaliInteger^{n}}\left|k\right|^{2\left(\left|\alpha\right|-m\right)}\right)^{\nicefrac{1}{2}}\left(\sum_{k\in\kaliInteger^{n}}\left|k\right|^{2m}\left|\widehat{\phi}\left(k\right)\right|^{2}\right)^{\nicefrac{1}{2}}\\
 & \leq\left(\sum_{k\in\kaliInteger^{n}}\left|k\right|^{2\left(N-m\right)}\right)^{\nicefrac{1}{2}}\left(\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{m}\left|\widehat{\phi}\left(k\right)\right|^{2}\right)^{\nicefrac{1}{2}}\\
 & \leq\left(\sum_{k\in\kaliInteger^{n}}\left|k\right|^{2\left(N-m\right)}\right)^{\nicefrac{1}{2}}p_{m}\left(\phi\right)
\end{align*}

\end_inset

ולכן 
\begin_inset Formula 
\[
q_{N}\left(\phi\right)\leq\left(\sum_{k\in\kaliInteger^{n}}\left|k\right|^{2\left(N-m\right)}\right)^{\nicefrac{1}{2}}p_{m}\left(\phi\right)
\]

\end_inset

כלומר הראינו שלכל 
\begin_inset Formula $N$
\end_inset

 יש 
\begin_inset Formula $C_{N}>0$
\end_inset

 ו-
\begin_inset Formula $m_{N}$
\end_inset

 שלם עבורם 
\begin_inset Formula $q_{N}\leq C_{N}p_{m_{N}}$
\end_inset

 על 
\begin_inset Formula $\mathcal{D}\left(T^{n}\right)$
\end_inset

.
 זה מראה ש-
\begin_inset Formula $\tau_{p}\subseteq\tau_{q}$
\end_inset

.
\begin_inset Newline newline
\end_inset

כלומר אכן 
\begin_inset Formula $\tau_{q}=\tau_{p}$
\end_inset

 כפי שרצינו.
\begin_inset Newline newline
\end_inset

יהא 
\begin_inset Formula $\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

 המרחב של הפונקציונלים הלינארים הרציפים על 
\begin_inset Formula $\mathcal{D}\left(T^{n}\right)$
\end_inset

 ביחס לטופולוגיה האחרונה.
\begin_inset Newline newline
\end_inset

האיברים של 
\begin_inset Formula $\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

 הם ההתפלגויות על 
\begin_inset Formula $T^{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

נגדיר את מקדמי פוריה של התפלגות 
\begin_inset Formula $u\in\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

 ע
\begin_inset Quotes erd
\end_inset

י 
\begin_inset Formula $\widehat{u}\left(k\right)=u\left(e_{-k}\right)$
\end_inset

 לכל 
\begin_inset Formula $k\in\kaliInteger^{n}$
\end_inset

.
\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $N$
\end_inset

 נסמן 
\begin_inset Formula $V_{N}=\left\{ \phi\in\mathcal{D}\left(T^{n}\right):p_{N}\left(\phi\right)<N^{-1}\right\} $
\end_inset

.
\begin_inset Newline newline
\end_inset

מכך שלכל 
\begin_inset Formula $\phi$
\end_inset

 מתקיים 
\begin_inset Formula $p_{1}\left(\phi\right)\leq p_{2}\left(\phi\right)\leq\ldots$
\end_inset

, הרי ש-
\begin_inset Formula $\left\{ V_{N}\right\} $
\end_inset

 הוא בסיס מקומי של 
\begin_inset Formula $\mathcal{D}\left(T^{n}\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

עכשיו תהא 
\begin_inset Formula $u\in\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

.
 אז מרציפות, קיים 
\begin_inset Formula $N$
\end_inset

 עבורו לכל 
\begin_inset Formula $\phi\in V_{N}$
\end_inset

 מתקיים 
\begin_inset Formula $\left|u\left(\phi\right)\right|<1$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $k$
\end_inset

 מתקיים 
\begin_inset Formula $p_{N}\left(e_{-k}\right)=\left(1+\left|k\right|^{2}\right)^{N}$
\end_inset

.
\begin_inset Newline newline
\end_inset

לכן לכל 
\begin_inset Formula $k$
\end_inset

 מתקיים 
\begin_inset Formula 
\[
p_{N}\left(\left(2N\left(1+\left|k\right|^{2}\right)^{N}\right)^{-1}e_{-k}\right)=\frac{1}{2N}<\frac{1}{N}
\]

\end_inset

כלומר לכל 
\begin_inset Formula $k$
\end_inset

 מתקיים 
\begin_inset Formula $\left(2N\left(1+\left|k\right|^{2}\right)^{N}\right)^{-1}e_{-k}\in V_{N}$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $k$
\end_inset

 מתקיים 
\begin_inset Formula $\left|u\left(\left(2N\left(1+\left|k\right|^{2}\right)^{N}\right)^{-1}e_{-k}\right)\right|<1$
\end_inset

.
\begin_inset Newline newline
\end_inset

לכן לכל 
\begin_inset Formula $k$
\end_inset

 מתקיים 
\begin_inset Formula 
\[
\left|u\left(e_{-k}\right)\right|\leq2N\left(1+\left|k\right|^{2}\right)^{N}\leq2N\left(1+\left|k\right|\right)^{2N}
\]

\end_inset

אז הראינו בכך שלכל 
\begin_inset Formula $u$
\end_inset

 קיימים 
\begin_inset Formula $C>0$
\end_inset

 ו-
\begin_inset Formula $N$
\end_inset

 עבורם 
\begin_inset Formula $\left|\widehat{u}\left(k\right)\right|\leq C\left(1+\left|k\right|\right)^{N}$
\end_inset

.
\begin_inset Newline newline
\end_inset

עכשיו תהא 
\begin_inset Formula $g$
\end_inset

 פונקציה מרוכבת כלשהי על 
\begin_inset Formula $\kaliInteger^{n}$
\end_inset

 עבורה יש 
\begin_inset Formula $C,N$
\end_inset

 עם 
\begin_inset Formula $\left|g\left(k\right)\right|\leq C\left(1+\left|k\right|\right)^{N}$
\end_inset

 לכל 
\begin_inset Formula $k$
\end_inset

.
\begin_inset Newline newline
\end_inset

ניקח 
\begin_inset Formula $m$
\end_inset

 גדול מספיק עבורו 
\begin_inset Formula $\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{2\left(N-m\right)}<\infty$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(T^{n}\right)$
\end_inset

 נקבל מא
\begin_inset Quotes erd
\end_inset

ש הלדר
\begin_inset Formula 
\begin{align*}
\sum_{k\in\kaliInteger^{n}}\left|g\left(-k\right)\right|\left|\widehat{\phi}\left(k\right)\right| & \leq C\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|\right)^{N}\left|\widehat{\phi}\left(k\right)\right|\\
 & \leq C\left(\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{2\left(N-m\right)}\right)^{\nicefrac{1}{2}}\left(\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{2m}\left|\widehat{\phi}\left(k\right)\right|^{2}\right)^{\nicefrac{1}{2}}\\
 & <C\left(\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{2\left(N-m\right)}\right)^{\nicefrac{1}{2}}p_{2m}\left(\phi\right)<\infty
\end{align*}

\end_inset

ולכן הטור 
\begin_inset Formula $\sum_{k\in\kaliInteger^{n}}g\left(-k\right)\widehat{\phi}\left(k\right)$
\end_inset

 מתכנס בהחלט לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(T^{n}\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז נוכל להגדיר 
\begin_inset Formula $u\left(\phi\right)=\sum_{k\in\kaliInteger^{n}}g\left(-k\right)\widehat{\phi}\left(k\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

קל לראות ש-
\begin_inset Formula $u$
\end_inset

 פונקציונל לינארי על 
\begin_inset Formula $\mathcal{D}\left(T^{n}\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

עבור 
\begin_inset Formula $\varepsilon>0$
\end_inset

, מרציפות 
\begin_inset Formula $p_{2m}$
\end_inset

 נוכל לבחור 
\begin_inset Formula $V$
\end_inset

 סביבה של 
\begin_inset Formula $0$
\end_inset

 ב-
\begin_inset Formula $\mathcal{D}\left(T^{n}\right)$
\end_inset

 עבורה 
\begin_inset Formula 
\[
p_{2m}\left(\phi\right)<C^{-1}\left(\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{2\left(N-m\right)}\right)^{-\nicefrac{1}{2}}\varepsilon
\]

\end_inset

 לכל 
\begin_inset Formula $\phi\in V$
\end_inset

.
 אז ממה שראינו נקבל
\begin_inset Formula 
\begin{align*}
\left|u\left(\phi\right)\right| & \leq\sum_{k\in\kaliInteger^{n}}\left|g\left(-k\right)\right|\left|\widehat{\phi}\left(k\right)\right|<C\left(\sum_{k\in\kaliInteger^{n}}\left(1+\left|k\right|^{2}\right)^{2\left(N-m\right)}\right)^{\nicefrac{1}{2}}p_{2m}\left(\phi\right)\\
 & <\varepsilon
\end{align*}

\end_inset

לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(T^{n}\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

זה מראה ש-
\begin_inset Formula $u$
\end_inset

 רציפה, כלומר 
\begin_inset Formula $u\in\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

לבסוף, לכל 
\begin_inset Formula $l\in\kaliInteger^{n}$
\end_inset

 מתקיים
\begin_inset Formula 
\[
\widehat{u}\left(l\right)=u\left(e_{-l}\right)=\sum_{k\in\kaliInteger^{n}}g\left(-k\right)\widehat{e_{-l}}\left(k\right)=g\left(l\right)
\]

\end_inset

כלומר 
\begin_inset Formula $\widehat{u}=g$
\end_inset

.
\begin_inset Newline newline
\end_inset

זה מראה ש-
\begin_inset Formula $u\mapsto\widehat{u}$
\end_inset

 האי העתקה חח
\begin_inset Quotes erd
\end_inset

ע ועל מ-
\begin_inset Formula $\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

 לאוסף הפונקציות על 
\begin_inset Formula $\kaliInteger^{n}$
\end_inset

 עם גידול פולינומי.
\begin_inset Newline newline
\end_inset

יהיו 
\begin_inset Formula $E_{1}\subseteq E_{2}\subseteq E_{3}\subseteq\cdots$
\end_inset

 תתי-קבוצות סופיות של 
\begin_inset Formula $\kaliInteger^{n}$
\end_inset

 עבורן 
\begin_inset Formula $\kaliInteger^{n}=\bigcup_{m}E_{m}$
\end_inset

.
\begin_inset Newline newline
\end_inset

תהא 
\begin_inset Formula $u\in\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

כפי שראינו קודם, מתקיים 
\begin_inset Formula $u\left(\phi\right)=\sum_{k\in\kaliInteger^{n}}\widehat{u}\left(-k\right)\widehat{\phi}\left(k\right)$
\end_inset

 לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(T^{n}\right)$
\end_inset

 כאשר ההתכנסות היא בהחלט.
\begin_inset Newline newline
\end_inset

אז בפרט מתקיים 
\begin_inset Formula $\sum_{k\in E_{m}}\widehat{u}\left(-k\right)\widehat{\phi}\left(k\right)\xrightarrow[m\rightarrow\infty]{}u\left(\phi\right)$
\end_inset

.
\begin_inset Newline newline
\end_inset

מצד שני לכל 
\begin_inset Formula $m$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\sum_{k\in E_{m}}\widehat{u}\left(-k\right)\widehat{\phi}\left(k\right) & =\sum_{k\in E_{m}}\widehat{u}\left(-k\right)\intop_{T^{n}}e_{-k}\phi d\sigma_{n}\\
 & =\intop_{T^{n}}\left(\sum_{k\in E_{m}}\widehat{u}\left(k\right)e_{k}\right)\phi d\sigma_{n}
\end{align*}

\end_inset

ולכן לכל 
\begin_inset Formula $\phi\in\mathcal{D}\left(T^{n}\right)$
\end_inset

 מתקיים
\begin_inset Formula 
\[
\intop_{T^{n}}\left(\sum_{k\in E_{m}}\widehat{u}\left(k\right)e_{k}\right)\phi d\sigma_{n}\xrightarrow[m\rightarrow\infty]{}u\left(\phi\right)
\]

\end_inset

כלומר אכן 
\begin_inset Formula $\sum_{k\in E_{m}}\widehat{u}\left(k\right)e_{k}\xrightarrow[m\rightarrow\infty]{}u$
\end_inset

 בטופולוגיה החלשה
\begin_inset Formula $^{*}$
\end_inset

 של 
\begin_inset Formula $\mathcal{D}^{\prime}\left(T^{n}\right)$
\end_inset

 כנדרש.
\end_layout

