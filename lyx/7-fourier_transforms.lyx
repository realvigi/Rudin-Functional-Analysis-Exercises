\end_inset

.
\begin_inset Newline newline
\end_inset

מכך ש-
\begin_inset Formula $f,g\in\mathcal{S}_{n}$
\end_inset

, עם 
\begin_inset Formula $y\mapsto y^{\gamma}D^{\alpha}g\left(y\right),y\mapsto y^{\beta-\gamma}f\left(y\right)$
\end_inset

 הם ב-
\begin_inset Formula $\mathcal{S}_{n}$
\end_inset

 לכל 
\begin_inset Formula $\gamma\leq\beta$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז יש 
\begin_inset Formula $M$
\end_inset

 עבורו 
\begin_inset Formula $\left|\left(1+\left|y\right|^{2}\right)^{N}y^{\beta-\gamma}f\left(y\right)\right|,\left|\left(1+\left|y\right|^{2}\right)^{N}y^{\gamma}\left(D^{\alpha}g\right)\left(y\right)\right|<M$
\end_inset

 לכל 
\begin_inset Formula $y$
\end_inset

.
\begin_inset Newline newline
\end_inset

כלומר לכל 
\begin_inset Formula $y$
\end_inset

 מתקיים 
\begin_inset Formula $\left|y^{\gamma}\left(D^{\alpha}g\right)\left(y\right)\right|^{2}<M^{2}\left(1+\left|y\right|^{2}\right)^{-2N}$
\end_inset

 וגם 
\begin_inset Formula $\left|y^{\beta-\gamma}f\left(y\right)\right|^{2}<M^{2}\left(1+\left|y\right|^{2}\right)^{-2N}$
\end_inset

.
\begin_inset Newline newline
\end_inset

אז לכל 
\begin_inset Formula $x\in R^{n}$
\end_inset

 ולכל 
\begin_inset Formula $k$
\end_inset

 נקבל
\begin_inset Formula 
\begin{align*}
\left|x^{\beta}\left(D^{\alpha}\left(f\ast g\right)\right)\left(x\right)\right| & \leq\sum_{\gamma\leq\beta}\left|c_{\beta\gamma}\right|\left(\intop_{R^{n}}M^{2}\left(1+\left|y\right|^{2}\right)^{-2N}dm_{n}\left(y\right)\right)^{\nicefrac{1}{2}}\left(\intop_{R^{n}}M^{2}\left(1+\left|y\right|^{2}\right)^{-2N}dm_{n}\left(y\right)\right)^{\nicefrac{1}{2}}\\
 & =\sum_{\gamma\leq\beta}\left|c_{\beta\gamma}\right|M^{2}\intop_{R^{n}}\left(1+\left|y\right|^{2}\right)^{-2N}dm_{n}\left(y\right)<\infty
\end{align*}

\end_inset

זה מראה שלכל 
\begin_inset Formula $\alpha,\beta$
\end_inset

 מולטי-אינדקסים, הפונקציה 
\begin_inset Formula $x\mapsto x^{\beta}D^{\alpha}\left(f\ast g\right)\left(x\right)$
\end_inset

 היא חסומה.
\begin_inset Newline newline
\end_inset

עכשיו אם 
\begin_inset Formula $P\left(x\right)=\sum_{\beta}d_{\beta}x^{\beta}$
\end_inset

 פולינום כלשהו, אז לכל 
\begin_inset Formula $\beta$
\end_inset

 יש יש 
\begin_inset Formula $M_{\beta}>0$
\end_inset

 עבורו
\begin_inset Formula 
\[
\sup_{x\in R^{n}}\left|x^{\beta}D^{\alpha}\left(f\ast g\right)\left(x\right)\right|\leq M_{\beta}
\]

\end_inset

ולכן
\begin_inset Formula 
\begin{align*}
\sup_{x\in R^{n}}\left|P\left(x\right)D^{\alpha}\left(f\ast g\right)\left(x\right)\right| & =\sup_{x\in R^{n}}\left|\sum_{\beta}d_{\beta}x^{\beta}D^{\alpha}\left(f\ast g\right)\left(x\right)\right|\\
 & \leq\sum_{\beta}\left|d_{\beta}\right|\sup_{x\in R^{n}}\left|x^{\beta}D^{\alpha}\left(f\ast g\right)\left(x\right)\right|\\
 & \leq\sum_{\beta}\left|d_{\beta}\right|M_{\beta}<\infty
\end{align*}

\end_inset

כלומר 
\begin_inset Formula $P\cdot D^{\alpha}\left(f\ast g\right)$
\end_inset

 היא חסומה לכל 
\begin_inset Formula $\alpha$
\end_inset

 ולכל 
\begin_inset Formula $P$
\end_inset

 ולכן 
\begin_inset Formula $f\ast g\in\mathcal{S}_{n}$
\end_inset

 כנדרש.
\end_layout

